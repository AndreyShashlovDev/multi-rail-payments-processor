NODE_ENV=development
SERVICE_NAME=core
HTTP_PORT=3001

SECURE_SIGNATURE_SECRETS='{"core":"secret123","ledger":"secret456","external-integration":"secret789"}'

# PostgreSQL
DB_HOST=localhost
DB_PORT=15432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=eventsourcing
DB_SCHEMA=core
DB_SSL=false
DB_LOGGING=true

# NATS
NATS_URL=nats://localhost:14222
NATS_CLIENT_NAME=core-service

# Kafka / Redpanda
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=core-service
KAFKA_GROUP_ID_PREFIX=core

# gRPC
GRPC_HOST=0.0.0.0
GRPC_PORT=50052

# gRPC Clients
LEDGER_GRPC_URL=localhost:50051
LEDGER_GRPC_TIMEOUT=5000
LEDGER_GRPC_RETRIES=3
LEDGER_GRPC_USE_SSL=false

LOG_LEVEL=debug
