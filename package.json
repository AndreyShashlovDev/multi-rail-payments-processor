{
  "name": "multi-rail-payments-processor",
  "version": "0.0.1",
  "description": "Multi-Rail Payments Processor",
  "author": "Andrey Shashlov",
  "private": false,
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:all": "nest build core && nest build ledger && nest build external-integration",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "start:dev:api-gateway": "nest start api-gateway --watch",
    "start:dev:ledger": "nest start ledger --watch",
    "start:dev:core": "nest start core --watch",
    "start:dev:external-integration": "nest start external-integration --watch",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "--integration--": "",
    "integration:migration:generate": "TS_NODE_PROJECT=./tsconfig.typeorm.json node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli.js migration:generate apps/external-integration/src/data/data-source/postgres/migrations/Migration -d apps/external-integration/src/data/data-source/postgres/integration-postgres.config.ts",
    "integration:migration:run": "TS_NODE_PROJECT=./tsconfig.typeorm.json node -r tsconfig-paths/register -r ts-node/register apps/external-integration/src/data/data-source/postgres/migration-run.ts",
    "integration:migration:revert": "TS_NODE_PROJECT=./tsconfig.typeorm.json node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli.js migration:revert -d apps/external-integration/src/data/data-source/postgres/integration-postgres.config.ts",
    "integration:migration:show": "TS_NODE_PROJECT=./tsconfig.typeorm.json node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli.js migration:show -d apps/external-integration/src/data/data-source/postgres/integration-postgres.config.ts",
    "--ledger--": "",
    "ledger:migration:generate": "TS_NODE_PROJECT=./tsconfig.typeorm.json node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli.js migration:generate apps/ledger/src/data/data-source/postgres/migrations/Migration -d apps/ledger/src/data/data-source/postgres/ledger-postgres.config.ts",
    "ledger:migration:run": "TS_NODE_PROJECT=./tsconfig.typeorm.json node -r tsconfig-paths/register -r ts-node/register apps/ledger/src/data/data-source/postgres/migration-run.ts",
    "ledger:migration:revert": "TS_NODE_PROJECT=./tsconfig.typeorm.json node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli.js migration:revert -d apps/ledger/src/data/data-source/postgres/ledger-postgres.config.ts",
    "ledger:migration:show": "TS_NODE_PROJECT=./tsconfig.typeorm.json node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli.js migration:show -d apps/ledger/src/data/data-source/postgres/ledger-postgres.config.ts",
    "ledger:proto": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=libs/shared/src/services/ledger/v1/grpc/generated --ts_proto_opt=nestJs=true,forceLong=string,esModuleInterop=true --proto_path=libs/shared/src/services/ledger/v1/grpc libs/shared/src/services/ledger/v1/grpc/*.proto",
    "--core--": "",
    "core:migration:generate": "TS_NODE_PROJECT=./tsconfig.typeorm.json node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli.js migration:generate apps/core/src/data/data-source/postgres/migrations/Migration -d apps/core/src/data/data-source/postgres/core-postgres.config.ts",
    "core:migration:run": "TS_NODE_PROJECT=./tsconfig.typeorm.json node -r tsconfig-paths/register -r ts-node/register apps/core/src/data/data-source/postgres/migration-run.ts",
    "core:migration:revert": "TS_NODE_PROJECT=./tsconfig.typeorm.json node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli.js migration:revert -d apps/core/src/data/data-source/postgres/core-postgres.config.ts",
    "core:migration:show": "TS_NODE_PROJECT=./tsconfig.typeorm.json node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli.js migration:show -d apps/core/src/data/data-source/postgres/core-postgres.config.ts",
    "core:fixtures": "TS_NODE_PROJECT=./tsconfig.typeorm.json node -r tsconfig-paths/register -r ts-node/register apps/core/src/data/data-source/postgres/fixtures/fixtures.ts",
    "core:proto": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=libs/shared/src/services/core/v1/grpc/generated --ts_proto_opt=nestJs=true,forceLong=string,esModuleInterop=true --proto_path=libs/shared/src/services/core/v1/grpc libs/shared/src/services/core/v1/grpc/*.proto",
    "----": "",
    "migration:generate": "yarn integration:migration:generate && yarn core:migration:generate && yarn ledger:migration:generate",
    "migration:run": "yarn integration:migration:run && yarn core:migration:run && yarn ledger:migration:run",
    "migration:revert": "yarn integration:migration:revert && yarn core:migration:revert && yarn ledger:migration:revert",
    "fixtures": "yarn core:fixtures",
    "start:all": "concurrently -n ledger,core,external -c blue,green,yellow \"yarn start:dev:ledger\" \"yarn start:dev:core\" \"yarn start:dev:external-integration\"",
    "run:demo": "yarn migration:run && yarn fixtures && yarn start:all",
    "reset:demo": "yarn migration:revert"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.11.0",
    "@bufbuild/protoc-gen-es": "2.11.0",
    "@grpc/grpc-js": "1.14.3",
    "@grpc/proto-loader": "0.8.0",
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/microservices": "11.1.19",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/typeorm": "11.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "concurrently": "9.2.1",
    "decimal.js": "10.6.0",
    "dotenv": "17.4.2",
    "nats": "2.29.3",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.6.0",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.59.0",
    "@typescript-eslint/parser": "8.59.0",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-boundaries": "6.0.2",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.5.0",
    "jest": "30.3.0",
    "prettier": "3.8.3",
    "rimraf": "6.1.3",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "ts-loader": "9.5.7",
    "ts-node": "10.9.2",
    "ts-proto": "2.11.6",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^@app/shared(|/.*)$": "<rootDir>/libs/shared/src/$1",
      "^@app/types(|/.*)$": "<rootDir>/libs/types/src/$1",
      "^@app/utils(|/.*)$": "<rootDir>/libs/utils/src/$1"
    }
  }
}
