# === Application ===
NODE_ENV=development

# === PostgreSQL (Docker) ===
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=eventsourcing
DB_SSL=false
DB_LOGGING=true

# === NATS (Docker) ===
NATS_URL=nats://nats:4222

# === Kafka / Redpanda (Docker) ===
KAFKA_BROKERS=redpanda:9092
KAFKA_CLIENT_ID=core-service
KAFKA_GROUP_ID_PREFIX=core

# === Logging ===
LOG_LEVEL=debug
EOF
